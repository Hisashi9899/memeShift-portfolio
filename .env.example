# ─── Database (required) ─────────────────────────────
DB_ROOT_PASSWORD=change_this_root_pass
DB_PASSWORD=change_this_user_pass
DB_DATABASE=memeshift
DB_USERNAME=memeshift

# ─── Laravel (required) ───────────────────────────────
APP_KEY=
APP_URL=https://example.com

# ─── Sanctum / CORS ──────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=example.com
SESSION_DOMAIN=.example.com

# ─── Nginx port ───────────────────────────────────────
NGINX_PORT=80

# ─── Admin seed (first deploy only) ───────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_DISPLAY_NAME=管理者

# ─── Frontend URL (seed only) ─────────────────────────
FRONTEND_URL=https://example.com
