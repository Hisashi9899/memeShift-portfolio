{
    "name": "memeshift/logic",
    "license": "proprietary",
    "description": "memeShift standalone schedule generation engine (zero Laravel dependencies)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "memeshift/shared": "dev-main"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MemeShift\\Logic\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../shared"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "MemeShift\\Logic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:eq": "vendor/bin/phpunit tests/EquivalenceTest.php"
    }
}
